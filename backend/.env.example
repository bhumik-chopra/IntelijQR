INTELLIQR_APP_NAME=IntelliQR API
INTELLIQR_APP_ENV=development
INTELLIQR_DEBUG=true
INTELLIQR_API_V1_PREFIX=/api/v1
INTELLIQR_HOST=127.0.0.1
INTELLIQR_PORT=8000
INTELLIQR_LOG_LEVEL=INFO
INTELLIQR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
INTELLIQR_MONGODB_URI=mongodb://localhost:27017
INTELLIQR_MONGODB_DATABASE=intelliqr
INTELLIQR_MONGODB_REQUIRED_ON_STARTUP=false
INTELLIQR_MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
INTELLIQR_QR_STORAGE_DIRECTORY=../data/generated
INTELLIQR_BULK_STORAGE_DIRECTORY=../data/bulk
INTELLIQR_BULK_MAX_ROWS=250
INTELLIQR_SHARE_STORAGE_DIRECTORY=../data/shares
INTELLIQR_SHARE_MAX_FILE_BYTES=26214400
# Optional private Vercel Blob token. When set, ShareVault uses durable cloud
# object storage instead of the local filesystem.
INTELLIQR_BLOB_READ_WRITE_TOKEN=null
# For phone testing, replace 127.0.0.1 with this computer's LAN IP.
INTELLIQR_REDIRECT_BASE_URL=http://127.0.0.1:8000
INTELLIQR_FRONTEND_BASE_URL=http://127.0.0.1:5173
# Use a separate random value of at least 32 characters outside development.
INTELLIQR_VAULT_ENCRYPTION_KEY=replace-with-a-separate-32-character-secret
INTELLIQR_VAULT_GRANT_EXPIRE_MINUTES=5
INTELLIQR_JWT_SECRET=replace-with-at-least-32-random-characters
INTELLIQR_JWT_ALGORITHM=HS256
INTELLIQR_JWT_ISSUER=intelliqr-api
INTELLIQR_JWT_AUDIENCE=intelliqr-web
INTELLIQR_ACCESS_TOKEN_EXPIRE_MINUTES=15
INTELLIQR_REFRESH_TOKEN_EXPIRE_DAYS=7
INTELLIQR_REFRESH_COOKIE_NAME=intelliqr_refresh
INTELLIQR_COOKIE_SECURE=false
# Accounts matching this local allowlist become admins at registration or next login.
INTELLIQR_ADMIN_EMAILS=[]
# Optional SMTP delivery. Resend example: smtp.resend.com:587 with username resend and STARTTLS enabled.
INTELLIQR_SMTP_HOST=null
INTELLIQR_SMTP_PORT=1025
INTELLIQR_SMTP_USERNAME=null
INTELLIQR_SMTP_PASSWORD=null
INTELLIQR_SMTP_STARTTLS=false
INTELLIQR_BREVO_API_KEY=null
INTELLIQR_NOTIFICATION_FROM_EMAIL=notifications@intelliqr.local
INTELLIQR_NOTIFICATION_FROM_NAME=IntelliQR
